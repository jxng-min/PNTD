  m_Name: ShopSlot_Magician
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: ShopSlot_Magician
  isEnable: 1
  layout: 1
  headerText: '{heroName} - tier <color=#FFCE1B>{heroTier}</color>, {mode} - for
    <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Throws a fireball at the nearest enemy,

    dealing immediate Magic
    Damage and applying a non-stacking burn.

    Reapplying the burn refreshes its
    duration.'
  additionalHeaderText: Lv.3
  additionalTagText: <b><color=#FFCE1B>Intense Flames</color></b>
  additionalBodyText: Doubles the burn damage.
