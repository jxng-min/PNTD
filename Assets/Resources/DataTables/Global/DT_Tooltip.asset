  m_Script: {fileID: 11500000, guid: dcc9605cada34b2b82f96efa5d5317ff, type: 3}
  m_Name: ShopSlot_Artificer
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: ShopSlot_Artificer
  isEnable: 1
  layout: 1
  headerText: '{heroName} - tier <color=#FFCE1B>{heroTier}</color>, {mode} - for
    <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Periodically installs a magitech robot in an empty adjacent tile.

    Robots
    independently attack the nearest enemy.'
  additionalHeaderText: Lv.3
  additionalTagText: <b><color=#FFCE1B>Suppression Module</color></b>
  additionalBodyText: The magitech robot's attacks slow enemies by <color=#FFCE1B>30%</color>.
--- !u!114 &1640470927012095785
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcc9605cada34b2b82f96efa5d5317ff, type: 3}
  m_Name: PartySlot_Shotgunner
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: PartySlot_Shotgunner
  isEnable: 1
  layout: 3
  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>2</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: Fires <color=#FFCE1B>3</color> bullets in a <color=#FFCE1B>45</color>
    Degree spread toward the nearest enemy.
  additionalHeaderText: Lv.3
  additionalTagText: <b><color=#FFCE1B>Full Circle</color></b>
  additionalBodyText: Expands the firing spread from <color=#FFCE1B>45</color> to
    <color=#FFCE1B>360</color> Degree.
