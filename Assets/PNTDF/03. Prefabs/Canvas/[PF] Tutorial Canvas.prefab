  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JxModule.CharFX.CharFxRunner
  sourceText: 'PNTD is inspired by <swing><color=#FF3939>S</color><color=#FF9134>N</color><color=#FFF439>K</color><color=#6DC646>R</color><color=#4099FF>X</color><color=#BB6CFF>.</color></swing>


    you
    have to <color=#88FF5D>deploy</color> multiple heroes that auto-attack nearby
    enemies.

    you can also <color=#88FF5D>remove</color> or <color=#88FF5D>redeploy</color>
    heros.


    Combine the same heroes to level them up:

    At <color=#88FF5D>Lv.3</color>
    heroes unlock special effects.


    Hire heros of the same classes to unlock
    class passives:

    Each hero can have between <color=#88FF5D>1 to 3</color>
    classes.


    You gain <color=#88FF5D>1 interest per 5 gold</color>, up to a
    maximum of 5.

    This means that saving above <color=#88FF5D>25 gold</color>
    doesn''t yield  more interest.


'
  cfxEnable: 1
  playMode: 1
  onceDuration: 1
  restoreWhenFinished: 1
