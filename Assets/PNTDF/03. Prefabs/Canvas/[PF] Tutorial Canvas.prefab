    m_PersistentCalls:
      m_Calls: []
  m_text: 'PNTD is inspired by SNKRX.


    you have to deploy multiple heroes that
    auto-attack nearby enemies.

    you can also remove or redeploy heros.


    Combine
    the same heroes to level them up:

    At Lv.3 heroes unlock special effects.


    Hire
    heros of the same classes to unlock class passives:

    Each hero can have between
    1 to 3 classes.


    You gain 1 interest per 5 gold, up to a maximum of 5.

    This
    means that saving above 25 gold doesn''t yield  more interest.


'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8a22eec397f03114095476897267ddb9, type: 2}
  m_sharedMaterial: {fileID: -9078128208861140813, guid: 8a22eec397f03114095476897267ddb9, type: 2}
