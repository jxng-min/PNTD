  m_Script: {fileID: 11500000, guid: dcc9605cada34b2b82f96efa5d5317ff, type: 3}
  m_Name: PartySlot_Artillery
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: PartySlot_Artillery
  isEnable: 1
  layout: 3
  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>2</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Fires a large, slow cannonball toward the nearest enemy,

    piercing
    enemies along its path.'
  additionalHeaderText: 'Lv.3: <b><color=#FFCE1B>Accelerated Shell</color></b>'
  additionalTagText: 
  additionalBodyText: Doubles the cannonball's travel speed.
--- !u!114 &-3296859174731452398
MonoBehaviour:
  m_ObjectHideFlags: 0
