    seconds.'
  additionalHeaderText: 'Lv.3: <b><color=#FFCE1B>Circle of Knives</color></b>'
  additionalTagText: 
  additionalBodyText: Throws <color=#FFCE1B>8</color> daggers in a full <color=#FFCE1B>360</color>
    degree circle.
