  m_Name: PartySlot_Handgunner
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: PartySlot_Handgunner
  isEnable: 1
  layout: 3
  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>2</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Fires <color=#FFCE1B>3</color> bullets in a straight line toward the
    nearest enemy.

    Gains <color=#FFCE1B>5</color> Physical Attack Power each
    level.'
  additionalHeaderText: 'Lv.3: <b><color=#FFCE1B>Bullet Barrage</color></b>'
  additionalTagText: 
  additionalBodyText: Increases bullets fired per attack from <color=#FFCE1B>3</color>
    to <color=#FFCE1B>8</color>.
