  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>2</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Throws <color=#FFCE1B>3</color> returning daggers in a spread.

    Daggers
    damage enemies while traveling and returning and apply Bleed for <color=#FFCE1B>2</color>
    seconds.'
  additionalHeaderText: 'Lv.3: <b><color=#FFCE1B>Circle of Knives</color></b>'
  additionalTagText: 
  additionalBodyText: Throws <color=#FFCE1B>8</color> daggers in a full <color=#FFCE1B>360</color>
    degree circle.
