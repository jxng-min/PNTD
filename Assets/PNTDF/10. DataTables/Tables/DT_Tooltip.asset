  m_Script: {fileID: 11500000, guid: dcc9605cada34b2b82f96efa5d5317ff, type: 3}
  m_Name: PartySlot_Paladin
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: PartySlot_Paladin
  isEnable: 1
  layout: 3
  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>3</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: Creates sword spaces along the movement direction of the nearest enemy.
  additionalHeaderText: 'Lv.3: <b><color=#FFCE1B>Divine Formation</color></b>'
  additionalTagText: 
  additionalBodyText: Increases sword spaces per target from <color=#FFCE1B>3</color>
    to <color=#FFCE1B>6</color>.
--- !u!114 &-3078851126290405302
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcc9605cada34b2b82f96efa5d5317ff, type: 3}
  m_Name: PartySlot_Saturnian
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: PartySlot_Saturnian
  isEnable: 1
  layout: 3
  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>3</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: '<color=#FFCE1B>{orbCount}</color> orbs orbit this unit and deal Magic
    Damage on contact.

    The orbs periodically move between an inner and outer
    orbit. Gains <color=#FFCE1B>1</color> orb per level.'
  additionalHeaderText: 
  additionalTagText: 
  additionalBodyText: 
