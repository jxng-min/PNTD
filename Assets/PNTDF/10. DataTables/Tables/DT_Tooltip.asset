  m_Name: PartySlot_Jovian
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: PartySlot_Jovian
  isEnable: 1
  layout: 3
  headerText: '{heroName} - <color=#FFCE1B>Lv.{heroLevel}</color>, tier <color=#FFCE1B>3</color>,
    {mode} - for <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: '<color=#FFCE1B>{orbCount}</color> orbs orbit this unit.

    Orb contact
    deals Magic Damage and slows enemies by <color=#FFCE1B>20%</color>.

    Reapplying
    the slow refreshes its duration. Gains <color=#FFCE1B>1</color> orb per level.'
  additionalHeaderText: 
  additionalTagText: 
  additionalBodyText: 
