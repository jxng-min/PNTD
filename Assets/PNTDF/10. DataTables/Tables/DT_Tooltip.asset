  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: ShopSlot_Miner
  isEnable: 1
  layout: 1
  headerText: '{heroName} - tier <color=#FFCE1B>{heroTier}</color>, {mode} - for
    <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Fires a single ore projectile at the nearest enemy.

    After performing
    <color=#FFCE1B>5/4/3</color> attacks, drops <color=#FFCE1B>1 Gold</color> near
    itself.'
  additionalHeaderText: 
  additionalTagText: 
  additionalBodyText: 
--- !u!114 &-3190765810869832360
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
