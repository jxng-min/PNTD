  m_Name: ShopSlot_Artificer
  m_EditorClassIdentifier: Assembly-CSharp::PNTD.TooltipDataTableRow
  rowID: ShopSlot_Artificer
  isEnable: 1
  layout: 1
  headerText: '{heroName} - tier <color=#FFCE1B>{heroTier}</color>, {mode} - for
    <color=#FFCE1B>{deployCost}</color>'
  tagText: 'Classes : {heroSynergies}'
  bodyText: 'Periodically installs a magitech robot in an empty adjacent tile.

    Robots
    independently attack the nearest enemy.'
  additionalHeaderText: 'Lv.3: <b><color=#FFCE1B>Suppression Module</color></b>'
  additionalTagText: 
  additionalBodyText: The magitech robot's attacks slow enemies by <color=#FFCE1B>30%</color>.
--- !u!114 &1561989150229908932
